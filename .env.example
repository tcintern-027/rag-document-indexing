# ===================================================================
# AI Knowledge Assistant - Environment Configuration Template
# ===================================================================

# Groq API Key (Required for LLM answer generation)
# Obtain your free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Vector Store Persistence Directory (Default: backend/chroma_db)
CHROMA_DB_PATH=chroma_db

# Document Storage Directory (Default: backend/data)
DATA_FOLDER=data

# Text Chunking Settings
DEFAULT_CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Similarity Search Settings (Number of chunks retrieved per query)
TOP_K=3

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
